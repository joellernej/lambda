Cell["\<\
For simplicity, we choose \[Omega] to be constant, and write\
\>", "Text",
 CellChangeTimes->{{3.4806583402175617`*^9, 3.480658367329467*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Field", "[", 
    RowBox[{"\[Omega]", ",", "_", ",", "_", ",", 
     RowBox[{"{", "__", "}"}]}], "]"}], ":=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SD", "[", 
    RowBox[{"Field", "[", 
     RowBox[{"\[Omega]", ",", "___"}], "]"}], "]"}], ":=", "0"}], ";", 
  RowBox[{
   RowBox[{"TD", "[", 
    RowBox[{"Field", "[", 
     RowBox[{"\[Omega]", ",", "___"}], "]"}], "]"}], ":=", "0"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.4806603478936377`*^9, 3.4806603620337*^9}}],

Cell["We now write our generator as", "Text",
 CellChangeTimes->{{3.480658380547813*^9, 3.480658391088747*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"J", "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        OverscriptBox["\[Omega]", "^"], 
        RowBox[{"i", " ", "j"}]], "\[SmallCircle]", 
       SubscriptBox[
        OverscriptBox["S", "^"], "i"], "\[SmallCircle]", 
       SubscriptBox[
        OverscriptBox["S", "^"], "j"]}], "-", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["\[Omega]", "^"], 
        RowBox[{"i", " ", "j"}]], " ", "\[SmallCircle]", 
       RowBox[{"\[Del]", 
        SuperscriptBox[
         OverscriptBox["\[CapitalPhi]", "^"], "i"]}], "\[SmallCircle]", 
       RowBox[{"\[Del]", 
        SuperscriptBox[
         OverscriptBox["\[CapitalPhi]", "^"], "j"]}]}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.480655264408866*^9, 3.480655346426243*^9}, {
   3.480656795269658*^9, 3.480656795667906*^9}, {3.480656895576481*^9, 
   3.4806569138467007`*^9}, 3.480657797821093*^9}],

Cell["\<\
J is a primary field with conformal dimension 2 with respect to P. \
\>", "Text",
 CellChangeTimes->{{3.4806584065760813`*^9, 3.480658423794677*^9}, {
  3.4806584541796217`*^9, 3.480658472642932*^9}}],

