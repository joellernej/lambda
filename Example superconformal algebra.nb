Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"P", ",", "J"}], "\[RightAngleBracket]"}], " ", "-", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"\[Square]", "#"}]}], " ", "+", " ", 
         RowBox[{"2", "\[Lambda]", " ", "#"}], " ", "+", " ", 
         RowBox[{"\[Chi]", 
          RowBox[{"\[Del]", "#"}]}]}], ")"}]}], "&"}], "@", " ", "J"}], " ", "//",
     "ED"}], "//", "MDIC"}], "//", "Expand"}]], "Input",
 CellChangeTimes->{3.4806580851163073`*^9}],

