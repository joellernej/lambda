}, Open  ]],

Cell["The algebra of J with itself is calculated by", "Text",
 CellChangeTimes->{{3.480658558112574*^9, 3.480658571638463*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FixedPoint", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "//", 
          RowBox[{
           RowBox[{"SortExpression", "[", 
            RowBox[{"#", ",", 
             RowBox[{"{", 
              RowBox[{"\[Omega]", ",", "\[CapitalPhi]", ",", "S"}], "}"}]}], 
            "]"}], "&"}]}], "//", "MNOC"}], "//", "ED"}], "//", 
       "DoDeltaContractions"}], "//", "MDIC"}], ")"}], "&"}], ",", 
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{"J", ",", "J"}], "\[RightAngleBracket]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.480657530525235*^9, 3.4806576182228737`*^9}, {
  3.4806576825959806`*^9, 3.4806577315878553`*^9}}],

