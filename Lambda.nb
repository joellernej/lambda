Cell[BoxData[
 RowBox[{
  RowBox[{"LambdaBracketJacobiator", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"aExpr", "=", 
       RowBox[{"MDIU", "[", "a", "]"}]}], ",", 
      RowBox[{"bExpr", "=", 
       RowBox[{"MDIU", "[", "b", "]"}]}], ",", 
      RowBox[{"cExpr", "=", 
       RowBox[{"MDIU", "[", "c", "]"}]}], ",", "bcBracket", ",", "abBracket", 
      ",", "acBracket", ",", "Expr1", ",", "Expr2", ",", "Expr3", ",", 
      "tmpOdd", ",", "tmpEven", ",", "tmp\[Chi]"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"OddNumericQ", "[", "tmpOdd", "]"}], " ", ":=", " ", "True"}], 
     ";", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"NumericQ", "[", "tmpEven", "]"}], " ", ":=", " ", "True"}], 
     ";", " ", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Part", " ", "1"}], " ", "*)"}], "\n", 
     RowBox[{"bcBracket", "=", 
      RowBox[{
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"bExpr", ",", "cExpr"}], "\[RightAngleBracket]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Chi]", "\[Rule]", "tmpOdd"}], ",", 
         RowBox[{"\[Lambda]", "\[Rule]", "tmpEven"}]}], "}"}]}]}], ";", "\n", 
     "\n", 
     RowBox[{"Expr1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"aExpr", ",", "bcBracket"}], "\[RightAngleBracket]"}], "/.", 
        
        RowBox[{"tmpEven", "\[Rule]", "\[Rho]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"tmpOdd", "*", "\[Chi]"}], "\[Rule]", 
          RowBox[{"\[Eta]", "**", "\[Chi]"}]}], ",", 
         RowBox[{"tmpOdd", "\[Rule]", "\[Eta]"}]}], "}"}]}]}], ";", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<Expr1\>\"", "]"}], ";", 
       RowBox[{"Print", "[", "Expr1", "]"}], ";"}], "*)"}], "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Part", " ", "2"}], " ", "*)"}], "\n", 
     RowBox[{"abBracket", "=", 
      RowBox[{
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"aExpr", ",", "bExpr"}], "\[RightAngleBracket]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Chi]", "\[Rule]", "tmpOdd"}], ",", 
         RowBox[{"\[Lambda]", "\[Rule]", "tmpEven"}]}], "}"}]}]}], ";", "\n", 
     
     RowBox[{"Expr2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Boole", "[", 
             RowBox[{"GetSUSY", "[", "]"}], "]"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Grading", "[", "aExpr", "]"}], "+", "1"}], ")"}]}], 
           ")"}]}]}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{"abBracket", ",", "cExpr"}], 
                  "\[RightAngleBracket]"}], "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\[Lambda]", "\[Rule]", 
                    RowBox[{"(", 
                    RowBox[{"\[Lambda]", "+", "\[Rho]"}], ")"}]}], ",", 
                   RowBox[{"tmpEven", "\[Rule]", "\[Lambda]"}]}], "}"}]}], "//",
                 "Expand"}], ")"}], "/.", 
              RowBox[{
               RowBox[{"tmpOdd", "*", "\[Chi]"}], "\[Rule]", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "\[Lambda]"}], "-", 
                 RowBox[{"\[Eta]", "**", "tmp\[Chi]"}]}], ")"}]}]}], "//", 
             "Expand"}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"tmpOdd", "->", "tmp\[Chi]"}], ",", 
             RowBox[{"\[Chi]", "\[Rule]", 
              RowBox[{"(", 
               RowBox[{"tmp\[Chi]", "+", "\[Eta]"}], ")"}]}]}], "}"}]}], "//",
           "Expand"}], ")"}]}], "/.", 
       RowBox[{"tmp\[Chi]", "->", "\[Chi]"}]}]}], ";", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<Expr2\>\"", "]"}], ";", 
       RowBox[{"Print", "[", "Expr2", "]"}], ";"}], "*)"}], "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Part", " ", "3"}], " ", "*)"}], "\n", 
     RowBox[{"acBracket", "=", 
      RowBox[{
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"aExpr", ",", "cExpr"}], "\[RightAngleBracket]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Chi]", "\[Rule]", "tmpOdd"}], ",", 
         RowBox[{"\[Lambda]", "\[Rule]", "tmpEven"}]}], "}"}]}]}], ";", "\n", 
     
     RowBox[{"Expr3", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Boole", "[", 
                 RowBox[{"GetSUSY", "[", "]"}], "]"}], "+", 
                RowBox[{"Grading", "[", "aExpr", "]"}]}], ")"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Boole", "[", 
                 RowBox[{"GetSUSY", "[", "]"}], "]"}], "+", 
                RowBox[{"Grading", "[", "bExpr", "]"}]}], ")"}]}], ")"}]}]}], 
          
          RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"bExpr", ",", "acBracket"}], "\[RightAngleBracket]"}]}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Chi]", "\[Rule]", "\[Eta]"}], ",", 
           RowBox[{"\[Lambda]", "\[Rule]", "\[Rho]"}]}], "}"}]}], "/.", 
        RowBox[{"tmpEven", "\[Rule]", "\[Lambda]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"tmpOdd", "*", "\[Eta]"}], "\[Rule]", 
          RowBox[{"-", 
           RowBox[{"\[Eta]", "**", "\[Chi]"}]}]}], ",", 
         RowBox[{"tmpOdd", "\[Rule]", "\[Chi]"}]}], "}"}]}]}], ";", "\n", 
     RowBox[{"(*", 
      RowBox[{
