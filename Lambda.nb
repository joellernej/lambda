Cell[CellGroupData[{

Cell["Grading", "Subsection"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "[", "_", "]"}], " ", ":=", " ", "0"}], ";"}], "*)"}],
   "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "::", "notpropergrading"}], "=", 
     "\"\<The expression  `1` contains different gradings.\>\""}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "[", 
      RowBox[{"NormalOrder", "[", 
       RowBox[{"a_", ",", "b_"}], "]"}], "]"}], " ", ":=", " ", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Grading", "[", "a", "]"}], " ", "+", 
        RowBox[{"Grading", "[", "b", "]"}]}], ",", "2"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "[", 
      RowBox[{"TD", "[", "a_", "]"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Grading", "[", "a", "]"}], " ", "//", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "[", 
      RowBox[{"SD", "[", "a_", "]"}], "]"}], ":=", " ", 
     RowBox[{
      RowBox[{"1", "+", " ", 
       RowBox[{"Grading", "[", "a", "]"}]}], " ", "//", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "[", 
      RowBox[{
       RowBox[{"a_", "?", "NumericQ"}], "*", "b_"}], "]"}], ":=", 
     RowBox[{"Grading", "[", "b", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "[", 
      RowBox[{
       RowBox[{"a_", "?", "OddNumericQ"}], "*", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "+", 
       RowBox[{"Grading", "[", "b", "]"}]}], "//", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "[", 
      RowBox[{"a_", "?", "NumericQ"}], "]"}], ":=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "[", 
      RowBox[{"a_", "?", "OddNumericQ"}], "]"}], ":=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Grading", "[", "list_Plus", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gradings", "=", 
         RowBox[{"DeleteDuplicates", "@", 
          RowBox[{"(", 
           RowBox[{"Grading", "/@", 
            RowBox[{"(", 
             RowBox[{"List", "@@", "list"}], ")"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "@", "gradings"}], "=!=", "1"}], ",", 
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"Grading", "::", "notpropergrading"}], ",", "list"}], 
           "]"}]}], "]"}], ";", 
        RowBox[{"First", "@", "gradings"}]}]}], "]"}]}], ";"}], "\n", 
   "\n"}]}]], "Code",
 CellChangeTimes->{{3.491753970479268*^9, 3.491753997790015*^9}, {
