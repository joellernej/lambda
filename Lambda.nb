Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"calcSUSY", " ", "=", " ", "True"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SetSUSY", "[", 
     RowBox[{"val", ":", 
