Cell[CellGroupData[{

Cell["Symbols to export", "Section",
 CellChangeTimes->{{3.4797187599458838`*^9, 3.4797187890630836`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dim", "::", "\"\<usage\>\""}], "=", 
   "\"\<dim is the trace of the special field delta.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TD", "::", "\"\<usage\>\""}], "=", 
   "\"\<TD[expr] is the even derivative on expr. Denoted \[Square]expr, \
defining the command Square[expr].\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SD", "::", "\"\<usage\>\""}], "=", 
   "\"\<SD[expr] is the odd derivative on expr. Denoted \[Del]expr, defining \
the command Del[expr].\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Field", "::", "\"\<usage\>\""}], "=", 
   "\"\<Field[sym_Symbol,downindices_List,upindices_List,derivatives_List] is \
a field with symbol sym, \\\nlower indices are given by downindices, upper \
indices by upindices and the derivatives by derivatives. A symbol \\\nwith a \
hat,^, is interpreted as a field, and the indices are in placed as \\\n \
\!\(\*SubsuperscriptBox[OverscriptBox[\(sym\), \(^\)], \(l1\\\ l2, \\\ d1\\\ \
d2\), \(u1\\\ u2\)]\), with a comma separating the lower indices from the \
derivative indices.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NormalOrder", "::", "\"\<usage\>\""}], "=", 
   "\"\<NormalOrder[a,b] represents the normal ordered product of the fields \
a and b. \\\nIt is denoted (a\[SmallCircle]b), i.e. using the character \
SmallCircle. Write the input as \!\(\*
StyleBox[\"Esc\", \"KeyEvent\"]\)\!\(\*
StyleBox[\"\[ThinSpace]\", \"InlineCode\"]\)\!\(\*
StyleBox[\"sc\", \"InlineCode\"]\)\!\(\*
StyleBox[\"\[ThinSpace]\", \"InlineCode\"]\)\!\(\*
StyleBox[\"Esc\", \"KeyEvent\"]\)\!\(\*
StyleBox[\" \", \"KeyEvent\"]\)\!\(\*
StyleBox[\"b\", \"KeyEvent\"]\)\!\(\*
StyleBox[\".\", \"KeyEvent\"]\)\!\(\*
StyleBox[\" \", \"KeyEvent\"]\)\!\(\*
StyleBox[
RowBox[{\"\\\\\\\\\", \"n\"}], \"KeyEvent\"]\)If more terms are given, the \
normal ordering binds from the right, i.e. a\[SmallCircle]b\[SmallCircle]c \
are interpreted as (a\[SmallCircle]b)\[SmallCircle]c.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LambdaBracket", "::", "\"\<usage\>\""}], "=", 
   "\"\<LambdaBracket[a,b] calculates the \[Lambda]-bracket between a and \
b.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LambdaBracketChangeOrder", "::", "\"\<usage\>\""}], "=", 
   "\"\<LambdaBracketChangeOrder[a,b] calculates [\!\(\*SubscriptBox[\(a\), \
\(\[Lambda]\)]\)b], from the bracket [\!\(\*SubscriptBox[\(b\), \
\(\[Lambda]\)]\)a], using skew-symmetry.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Grading", "::", "\"\<usage\>\""}], "=", 
   "\"\<Grading[a] returns an even value if a is regarded as an even \
(bosonic) field, and an odd value if a is regarded odd (fermionic).\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NormalOrderChangeOrder", "::", "\"\<usage\>\""}], "=", 
   "\"\<NormalOrderChangeOrder[a,b] uses quasi-commutativity to express (a\
\[SmallCircle]b) as (b\[SmallCircle]a) + commutator. Short name is \
NOCO.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NormalOrderCommutator", "::", "\"\<usage\>\""}], "=", 
   "\"\<NormalOrderCommutator[a,b] calculates a\[SmallCircle]b - (-1)^(a b) b\
\[SmallCircle]a .\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NormalOrderAssociator", "::", "\"\<usage\>\""}], "=", 
   "\"\<NormalOrderAssociator[a,b,c] calculates ((a\[SmallCircle]b)\
\[SmallCircle]c) - (a\[SmallCircle](b\[SmallCircle]c)) .\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NormalOrderChangeParenthesis", "::", "\"\<usage\>\""}], "=", 
   "\"\<NormalOrderChangeParenthesis[expr] uses NormalOrderAssociator to \
express ((a\[SmallCircle]b)\[SmallCircle]c) or (a\[SmallCircle](b\
\[SmallCircle]c)) \\\nby means of the other expression. The expression (a\
\[SmallCircle]b)\[SmallCircle](c\[SmallCircle]d) is transformed to ((a\
\[SmallCircle]b)\[SmallCircle]c)\[SmallCircle]d . Short name NOCP.\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NormalOrderChangeParenthesisForward", "::", "\"\<usage\>\""}], 
   "=", "\"\<NormalOrderChangeParenthesisForward[expr] transforms an \
expression \\\nof the form (a\[SmallCircle]b)\[SmallCircle](c\[SmallCircle]d) \
to the form  (a\[SmallCircle](b\[SmallCircle](c\[SmallCircle]d)).\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CollectDerivatives", "::", "\"\<usage\>\""}], "=", 
   "\"\<CollectDerivatives[expr] tries to use Leibniz rule to write \
expressions involving \\\nderivatives more compact. Only works on the \
top-level of an expression. Short name is CD[expr].\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ExpandDerivatives", "::", "\"\<usage\>\""}], "=", 
   "\"\<ExpandDerivatives[expr] use Leibniz rule to expand derivatives. E.g. \
\[Square](\!\(\*OverscriptBox[\(a\), \
\(^\)]\)\[SmallCircle]\!\(\*OverscriptBox[\(b\), \(^\)]\)) is expanded to (\!\
\(\*OverscriptBox[\(a\), \
\(^\)]\)\[SmallCircle]\[Square]\!\(\*OverscriptBox[\(b\), \
\(^\)]\))+(\[Square]\!\(\*OverscriptBox[\(a\), \
\(^\)]\)\[SmallCircle]\!\(\*OverscriptBox[\(b\), \(^\)]\)). \\\nShort name is \
ED[expr].\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LambdaBracketJacobiator", "::", "\"\<usage\>\""}], "=", 
   "\"\<LambdaBracketJacobiator[a,b,c] calculates the Jacobiator of the \
Lambda Bracket. It is defined as \\\n[a Lambda [b Gamma c]] - \
(-1)^(N(a+1))[[a Lambda b] Gamma+Lambda c] - (-1)^((a+N)(b+N))[b Gamma [a \
Lambda c]] .\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LambdaBracketHandleIndices", "::", "\"\<usage\>\""}], "=", 
   "\"\<LambdaBracketHandleIndices[a,b] calculates [\!\(\*SubscriptBox[\(a\), \
\(\[Lambda]\)]\)b]. \\\nFirst, the dummy indices is replaced with unique \
names, using MakeDummyIndicesUnique. \\\nAfter the calculation, the indices \
are made canonical, using MakeDummyIndicesCanonical. \\\nInputed with the \
AngleBracket, i.e. \[LeftAngleBracket]a,b\[RightAngleBracket].\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeDummyIndicesUnique", "::", "\"\<usage\>\""}], "=", 
   "\"\<MakeDummyIndicesUnique[expr] makes repeated indices unique. Short \
name is MDIU.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeDummyIndicesCanonical", "::", "\"\<usage\>\""}], "=", 
   "\"\<MakeDummyIndicesCanonical[expr] renames repeated \\\nindices by the \
naming scheme \[Alpha], \[Beta], \[Gamma] etc. Short name is MDIC.\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]", "::", "\"\<usage\>\""}], "=", 
   "\"\<This symbol representing various poles in the calculated OPEs. \
Even.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]", "::", "\"\<usage\>\""}], "=", 
   "\"\<This symbol representing various poles in the calculated OPEs. Odd.\>\
\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]", "::", "\"\<usage\>\""}], "=", 
   "\"\<This symbol representing various poles in the calculated OPEs, when \
calculating the Jacobiator. Even.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]", "::", "\"\<usage\>\""}], "=", 
   "\"\<This symbol representing various poles in the calculated OPEs, when \
calculating the Jacobiator. Odd.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OddNumericQ", "::", "\"\<usage\>\""}], "=", 
   "\"\<OddNumericQ indicates that a variable is odd, e.g. like  \[Chi]. \\\n\
Note that SD[\[Chi]]:=2 \[Lambda] , but this is not implemented for a general \
OddNumericQ  . \>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeNormalOrderingCanonical", "::", "\"\<usage\>\""}], "=", 
   "\"\<MakeNormalOrderingCanonical[expr] change the \\\nnormal ordering to \
the scheme (a\[SmallCircle](b\[SmallCircle](c\[SmallCircle] ... ))). Short \
name is MNOC.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DoDeltaContractions", "::", "\"\<usage\>\""}], "=", 
   "\"\<DoDeltaContractions[expr] performs the possible \\\ncontractions with \
the special field \\!\\(\\*SubsuperscriptBox[OverscriptBox[\\\"\[Delta]\\\", \
\\\"^\\\"], \\\"\[Alpha]\\\", \\\"\[Beta]\\\"]\\) .\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MoveTerm", "::", "\"\<usage\>\""}], "=", 
   "\"\<MoveTerm[expr,pos,m] moves the element at position pos of the \
expression expr m steps\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SortExpression", "::", "\"\<usage\>\""}], "=", 
   "\"\<SortExpression[expr, order_List] sorts the expression expr, in the \
order specified by order. \\\nThe list order as the symbols of the fields as \
values. E.g. SortExpression[\!\(\*OverscriptBox[\(a\), \(^\)]\)\[SmallCircle]\
\!\(\*OverscriptBox[\(b\), \(^\)]\), {b,a}] yields \!\(\*OverscriptBox[\(b\), \
\(^\)]\)\[SmallCircle]\!\(\*OverscriptBox[\(a\), \(^\)]\) + terms from \\\n\
moving the fields. If the symbols of the fields are not included in order, \
alphabetic order are used. If \\\nSortDerivativesFirst is set to true, terms \
with derivatives are sorted first, in case of equal symbols, otherwise \
last.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SortDerivativesFirst", "::", "\"\<usage\>\""}], "=", 
   "\"\<SortDerivativesFirst= False|True sets, in case to fields have the \
same symbol, whether \\\nterms with derivatives should be sorted first or \
not.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FieldSymmetricUpperIndices", "::", "\"\<usage\>\""}], "=", 
   "\"\<FieldSymmetricUpperIndices[fieldsym_Symbol] declares that the field \
with the \\\nsymbol fieldsym are symmetric in its upper indices.\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FieldAntiSymmetricUpperIndices", "::", "\"\<usage\>\""}], "=", 
   "\"\<FieldAntiSymmetricUpperIndices[fieldsym_Symbol] declares that the \
field \\\nwith the symbol fieldsym are anti-symmetric in its upper indices.\>\
\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FieldSymmetricLowerIndices", "::", "\"\<usage\>\""}], "=", 
   "\"\<FieldSymmetricLowerIndices[fieldsym_Symbol] declares that the field \
with the \\\nsymbol fieldsym are symmetric in its lower indices.\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FieldAntiSymmetricLowerIndices", "::", "\"\<usage\>\""}], "=", 
   "\"\<FieldAntiSymmetricLowerIndices[fieldsym_Symbol] declares that the \
field \\\nwith the symbol fieldsym are anti-symmetric in its lower indices.\>\
\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DefineComponents", "::", "\"\<usage\>\""}], "=", 
   "\"\<DefineComponents[superfieldSym_Symbol,constPart_Symbol,thetaPart_\
Symbol] defines the \\\nexpansion of the superfield with symbol superfieldSym \
as Field[constPart,...] + \[Theta] Field[thetaPart,...].\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ExpandSuperFields", "::", "\"\<usage\>\""}], "=", 
   "\"\<ExpandSuperFields[expr] expands the superfield-expression expr into \
components. \\\nThe answer is of the form {{constant part, grading of this \
part},{theta-part, grading of this part}}\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ExpandDummyIndices", "::", "\"\<usage\>\""}], "=", 
   "\"\<ExpandDummyIndices[Expr_, indRange_List] replaces all dummy indices \
with values from indRange, \\\ne.g. \
ExpandDummyIndices[\!\(\*SubscriptBox[OverscriptBox[\(a\), \(^\)], \(i\)]\)\
\[SmallCircle]\!\(\*SuperscriptBox[OverscriptBox[\(b\), \(^\)], \
\(i\)]\),{1,2}] gives \!\(\*SubscriptBox[OverscriptBox[\(a\), \(^\)], \
\(1\)]\)\[SmallCircle]\!\(\*SuperscriptBox[OverscriptBox[\(b\), \(^\)], \
\(1\)]\)+\!\(\*SubscriptBox[OverscriptBox[\(a\), \(^\)], \(2\)]\)\
\[SmallCircle]\!\(\*SuperscriptBox[OverscriptBox[\(b\), \(^\)], \(2\)]\). \
This is useful when given concrete realizations of tensors.\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetSUSY", "::", "\"\<usage\>\""}], "=", 
   "\"\<SetSUSY[True] sets the lambda-bracket to be calculated within the N=1 \
formalisms. With \\\nSetSUSY[False], lambda-brackets are calculated without \
superfields.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GetSUSY", "::", "\"\<usage\>\""}], "=", 
   "\"\<GetSUSY[] returns true, if the lambda brackets are to be calculated \
in N=1 formalism, and false otherwise\>\""}], ";"}]}], "Code",
 CellChangeTimes->{
